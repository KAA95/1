# Пример переменных окружения для локального запуска.
# Не храните реальные пароли в репозитории.

VANESSA_RUNNER_PATH=C:\tools\vanessa-runner\vanessa-runner.exe
VANESSA_AUTOMATION_PATH=C:\tools\vanessa-automation\vanessa-automation.epf
ONEC_CONNECTION_STRING=/F C:\1c_bases\vkr_test
ONEC_USER=Tester
ONEC_PASSWORD=
ONEC_PLATFORM_PATH=C:\Program Files\1cv8\8.3.xx.xxxx\bin\1cv8.exe
TEST_BASE_BACKUP=C:\1c_backups\vkr_etalon.dt
TEST_RESULTS_DIR=artifacts\local
DEFAULT_TAG_EXPRESSION=@smoke and not @unstable
